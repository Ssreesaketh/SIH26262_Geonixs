# SIH26262 Environment Configuration Template

# Server & Security
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ENVIRONMENT=development

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GENERATED_BY_SETUP_SCRIPT
POSTGRES_DB=aicte_workflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:GENERATED_BY_SETUP_SCRIPT@localhost:5432/aicte_workflow
# SQLite fallback for quick local testing if PostgreSQL is not active:
# DATABASE_URL=sqlite:///./sih_workflow.db

# File Storage Configuration
STORAGE_DIR=./document_storage
MAX_FILE_SIZE_BYTES=10485760

# Frontend Host (for CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Seeded demo identities are created by backend/app/seed_data.py.
# Their legacy shared password is public/compromised: use only on isolated
# synthetic-data instances and rotate/disable before any shared deployment.

# Optional local Ollama integration. Leave empty for retrieval-only mode.
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:7b
AI_MAX_PDF_PAGES=60
OLLAMA_EMBED_MODEL=nomic-embed-text
